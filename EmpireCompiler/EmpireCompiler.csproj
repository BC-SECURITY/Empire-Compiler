<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <Version>0.2.3</Version>
    <AssemblyVersion>0.2.3</AssemblyVersion>
    <FileVersion>0.2.3</FileVersion>
    <InformationalVersion>0.2.3</InformationalVersion>
    <OutputType>Exe</OutputType>
    <!-- Single source of truth for the engine ABI. Core/Abi.cs and Data/abi are generated from this. -->
    <EngineAbi>2</EngineAbi>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Release;Debug</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\**" />
    <Content Remove="Data\**" />
    <EmbeddedResource Remove="Data\**" />
    <None Remove="Data\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILRepack.Lib" Version="2.0.44" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Confuser.Core">
      <HintPath>refs\Confuser.Core.dll</HintPath>
    </Reference>
    <Reference Include="Confuser.DynCipher">
      <HintPath>refs\Confuser.DynCipher.dll</HintPath>
    </Reference>
    <Reference Include="Confuser.MSBuild.Tasks">
      <HintPath>refs\Confuser.MSBuild.Tasks.dll</HintPath>
    </Reference>
    <Reference Include="Confuser.Protections">
      <HintPath>refs\Confuser.Protections.dll</HintPath>
    </Reference>
    <Reference Include="Confuser.Renamer">
      <HintPath>refs\Confuser.Renamer.dll</HintPath>
    </Reference>
    <Reference Include="Confuser.Runtime">
      <HintPath>refs\Confuser.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="dnlib">
      <HintPath>refs\dnlib.dll</HintPath>
    </Reference>
    <Reference Include="PeNet">
      <HintPath>refs\PeNet.dll</HintPath>
    </Reference>
    <Reference Include="Donut">
      <HintPath>refs\Donut.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Generate Abi.cs (into obj/) from EngineAbi so the constant cannot drift from the property. -->
  <Target Name="GenerateAbiSource" BeforeTargets="BeforeBuild;CoreCompile">
    <PropertyGroup>
      <AbiSourceFile>$(IntermediateOutputPath)Abi.cs</AbiSourceFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(AbiSourceFile)"
                      Lines="namespace EmpireCompiler.Core%3B public static class Abi { public const int Version = $(EngineAbi)%3B }"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(AbiSourceFile)" Link="Core/Abi.cs" />
      <FileWrites Include="$(AbiSourceFile)" />
    </ItemGroup>
  </Target>

  <!-- Emit Data/abi on every build so consumers can read the ABI without running the binary. -->
  <Target Name="WriteAbiFile" BeforeTargets="Build" DependsOnTargets="GenerateAbiSource">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/Data/abi"
                      Lines="$(EngineAbi)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
  <!-- RunCoff.cs is compiled separately into a net40 artifact (BuildPrebuiltRunCoff), not into the engine. -->
  <ItemGroup>
    <Compile Remove="RunCOFF/**" />
  </ItemGroup>

  <!-- Build the platform-independent net40 RunCOFF artifact into Data/Prebuilt using the SDK's Roslyn,
       so no mono/Windows toolchain is needed. Pinned to the bundled CS_COFFLoader.
       Release CI builds it once and passes -p:SkipPrebuiltRunCoff=true to the per-OS publish legs. -->
  <Target Name="BuildPrebuiltRunCoff" BeforeTargets="Build" Condition="'$(SkipPrebuiltRunCoff)' != 'true'">
    <PropertyGroup>
      <RunCoffCsc>$(RoslynTargetsPath)/bincore/csc.dll</RunCoffCsc>
      <RunCoffRefs>$(MSBuildProjectDirectory)/Data/AssemblyReferences/net40</RunCoffRefs>
      <RunCoffLoader>$(MSBuildProjectDirectory)/Data/ReferenceSourceLibraries/CS_COFFLoader/CoffLoader</RunCoffLoader>
      <RunCoffOut>$(MSBuildProjectDirectory)/Data/Prebuilt/RunCoff.exe</RunCoffOut>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/Data/Prebuilt" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; exec &quot;$(RunCoffCsc)&quot; -nologo -nostdlib -noconfig -unsafe -deterministic -target:exe -main:Program -out:&quot;$(RunCoffOut)&quot; -r:&quot;$(RunCoffRefs)/mscorlib.dll&quot; -r:&quot;$(RunCoffRefs)/System.dll&quot; -r:&quot;$(RunCoffRefs)/System.Core.dll&quot; &quot;$(MSBuildProjectDirectory)/RunCOFF/RunCoff.cs&quot; &quot;$(RunCoffLoader)/Program.cs&quot; &quot;$(RunCoffLoader)/src/CoffParser.cs&quot; &quot;$(RunCoffLoader)/src/CoffStructs.cs&quot;" />
  </Target>
</Project>
